,"type":"text"},{"type":"codeVoice","code":"preferredResolution"},{"text":" is used to define its aspect ratio. When publishing","type":"text"},{"text":" ","type":"text"},{"text":"a video frame, ","type":"text"},{"type":"codeVoice","code":"preferredResolution"},{"text":" is used as the bounding box. For example: assuming ","type":"text"},{"type":"codeVoice","code":"preferredResolution"},{"text":" ","type":"text"},{"text":"is 100 x 200, internally video is capatured at ","type":"text"},{"type":"codeVoice","code":"high"},{"text":" preset, for example  1080 x 1920. The renderred video stream","type":"text"},{"text":" ","type":"text"},{"text":"will have resolution of 960 x 1920, whereas the published video stream will have resolution 100 x 200 which is","type":"text"},{"text":" ","type":"text"},{"text":"scaled down from the 960 x 1920 rendered video stream.","type":"text"}]}]}],"hierarchy":{"paths":[["doc:\/\/io.aircore.media\/documentation\/AircoreMedia","doc:\/\/io.aircore.media\/documentation\/AircoreMedia\/Camera"]]},"references":{"doc://io.aircore.media/documentation/AircoreMedia":{"role":"collection","identifier":"doc:\/\/io.aircore.media\/documentation\/AircoreMedia","type":"topic","title":"AircoreMedia","kind":"symbol","url":"\/documentation\/aircoremedia","abstract":[{"type":"text","text":"The Aircore Media SDK for iOS allows you to add high-quality, real-time voice and video chat to your iOS app quickly and easily, without the need to understand the complexities of building a real-time system on your own."}]},"doc://io.aircore.media/documentation/AircoreMedia/Camera/setPreferredResolution(_:)":{"abstract":[{"text":"Sets the preferred resolution of captured video.","type":"text"}],"title":"setPreferredResolution(_:)","kind":"symbol","url":"\/documentation\/aircoremedia\/camera\/setpreferredresolution(_:)","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"setPreferredResolution"},{"kind":"text",