{"schemaVersion":{"major":0,"minor":3,"patch":0},"kind":"symbol","metadata":{"roleHeading":"Instance Method","symbolKind":"method","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"setLogDirPath"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":")"}],"modules":[{"name":"AircoreMedia"}],"externalID":"c:@CM@AircoreMedia@objc(cs)AIREngine(im)setLogDirPath:","title":"setLogDirPath(_:)","role":"symbol","extendedModule":"AircoreMedia"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/io.aircore.media\/documentation\/AircoreMedia\/Engine\/setLogDirPath(_:)"},"hierarchy":{"paths":[["doc:\/\/io.aircore.media\/documentation\/AircoreMedia","doc:\/\/io.aircore.media\/documentation\/AircoreMedia\/Engine"]]},"abstract":[{"type":"text","text":"Sets the directory path for where to store logs."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/aircoremedia\/engine\/setlogdirpath(_:)"]}],"primaryContentSections":[{"declarations":[{"platforms":["iOS"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"setLogDirPath"},{"kind":"text","text":"("},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"value"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":")"}],"languages":["swift"]}],"kind":"declarations"},{"parameters":[{"name":"value","content":[{"inlineContent":[{"type":"text","text":"The path to the directory of where to store logs."}],"type":"paragraph"}]}],"kind":"parameters"},{"content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"This should only be set "},{"type":"strong","inlineContent":[{"text":"once","type":"text"}]},{"type":"text","text":" and should be done before performing any other actio